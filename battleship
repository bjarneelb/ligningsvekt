<!DOCTYPE html>
<html lang="no">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Koordinatslag</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Nunito:wght@700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0f1e;
  --panel: #0d1628;
  --border: #1a3a5c;
  --accent: #00d4ff;
  --green: #00ff88;
  --red: #ff3344;
  --yellow: #ffd700;
  --muted: #4a6a8a;
  --text: #c8e0f0;
  --hit: #ff4422;
  --miss: #2288ff;
  --ship: #3a7a4a;
  --ship-sunk: #1a3a2a;
  --font-mono: 'Share Tech Mono', monospace;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Nunito', sans-serif;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex; flex-direction: column; align-items: center;
  overflow-x: hidden;
}

/* ── HEADER ── */
.header {
  width: 100%; background: #060c18;
  border-bottom: 2px solid var(--accent);
  padding: 10px 24px;
  display: flex; align-items: center; justify-content: space-between;
  box-shadow: 0 0 20px rgba(0,212,255,0.2);
}
.header-title {
  font-family: var(--font-mono);
  font-size: 1.3rem; color: var(--accent);
  letter-spacing: 3px;
  text-shadow: 0 0 10px rgba(0,212,255,0.5);
}
.header-status {
  font-family: var(--font-mono);
  font-size: 0.85rem; color: var(--green);
  padding: 4px 12px;
  border: 1px solid var(--green);
  border-radius: 4px;
}
.header-right { display: flex; align-items: center; gap: 12px; }
.btn-menu {
  font-family: var(--font-mono);
  font-size: 0.75rem; color: var(--muted);
  padding: 4px 12px;
  border: 1px solid var(--muted);
  border-radius: 4px;
  text-decoration: none;
  transition: color 0.2s, border-color 0.2s;
}
.btn-menu:hover { color: var(--accent); border-color: var(--accent); }

/* ── OVERLAY SCREENS ── */
.overlay {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(6,12,24,0.97);
  display: flex; align-items: center; justify-content: center;
  flex-direction: column;
}
.screen-card {
  background: var(--panel);
  border: 2px solid var(--accent);
  border-radius: 12px;
  padding: 36px 40px;
  width: 480px;
  box-shadow: 0 0 40px rgba(0,212,255,0.15);
  text-align: center;
}
.screen-card h1 {
  font-family: var(--font-mono);
  font-size: 1.8rem; color: var(--accent);
  letter-spacing: 3px; margin-bottom: 8px;
}
.screen-card p { color: var(--muted); font-size: 0.88rem; margin-bottom: 20px; }
.screen-name { color: var(--green); font-weight: 800; font-size: 1rem; margin-bottom: 20px; }

/* Inputs */
.field-group { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; text-align: left; }
.field-label { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
.field-input {
  width: 100%; padding: 10px 14px;
  background: #060c18; border: 1px solid var(--border);
  border-radius: 6px; color: var(--text);
  font-family: var(--font-mono); font-size: 1rem;
  outline: none; text-transform: uppercase; letter-spacing: 2px; text-align: center;
  transition: border-color 0.2s;
}
.field-input:focus { border-color: var(--accent); }
.field-row { display: flex; gap: 8px; }
.field-row .field-input { flex: 1; }

.btn-primary {
  width: 100%; padding: 12px;
  background: transparent; border: 2px solid var(--accent);
  border-radius: 6px; color: var(--accent);
  font-family: var(--font-mono); font-size: 0.95rem;
  letter-spacing: 2px; cursor: pointer;
  transition: background 0.2s, box-shadow 0.2s;
  margin-top: 4px;
}
.btn-primary:hover {
  background: rgba(0,212,255,0.1);
  box-shadow: 0 0 20px rgba(0,212,255,0.3);
}
.btn-secondary {
  width: 100%; padding: 10px;
  background: transparent; border: 1px solid var(--muted);
  border-radius: 6px; color: var(--muted);
  font-family: var(--font-mono); font-size: 0.85rem;
  cursor: pointer; margin-top: 8px;
  transition: color 0.2s, border-color 0.2s;
}
.btn-secondary:hover { color: var(--text); border-color: var(--text); }

/* ── PLACEMENT SCREEN ── */
.placement-screen {
  width: 100%; max-width: 1100px;
  padding: 16px;
  display: flex; gap: 20px; align-items: flex-start;
}
.placement-left { flex: 1; }
.placement-right { width: 320px; flex-shrink: 0; }

.ship-list { display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px; }
.ship-row {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 14px;
}
.ship-row.placed { border-color: var(--green); }
.ship-row.error  { border-color: var(--red); }
.ship-name { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); margin-bottom: 6px; }
.ship-len  { font-size: 0.72rem; color: var(--muted); margin-bottom: 8px; }
.ship-inputs { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.coord-input {
  width: 52px; padding: 6px 8px;
  background: #060c18; border: 1px solid var(--border);
  border-radius: 4px; color: var(--text);
  font-family: var(--font-mono); font-size: 0.88rem;
  text-align: center; outline: none;
}
.coord-input:focus { border-color: var(--accent); }
.ship-sep { color: var(--muted); font-size: 0.8rem; }
.ship-status { font-size: 0.72rem; margin-top: 4px; min-height: 16px; }
.ship-status.ok  { color: var(--green); }
.ship-status.err { color: var(--red); }

.section-title {
  font-family: var(--font-mono);
  font-size: 0.72rem; color: var(--muted);
  letter-spacing: 2px; text-transform: uppercase;
  margin-bottom: 10px;
  border-bottom: 1px solid var(--border);
  padding-bottom: 6px;
}

/* ── GAME SCREEN ── */
.game-screen {
  width: 100%; max-width: 1200px;
  padding: 14px 16px;
  display: flex; flex-direction: column; gap: 12px;
}
.boards-row { display: flex; gap: 16px; align-items: flex-start; }
.board-wrap { flex: 1; }
.board-label {
  font-family: var(--font-mono);
  font-size: 0.72rem; color: var(--muted);
  letter-spacing: 2px; text-transform: uppercase;
  margin-bottom: 6px; text-align: center;
}
.board-label span { color: var(--accent); }

/* ── SVG GRID ── */
.grid-svg { width: 100%; aspect-ratio: 1; display: block; }

/* ── SHOT INPUT ── */
.shot-panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 14px 18px;
}
.shot-row { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
.shot-field { display: flex; flex-direction: column; gap: 4px; }
.shot-label { font-family: var(--font-mono); font-size: 0.68rem; color: var(--muted); letter-spacing: 1px; }
.shot-input {
  width: 72px; padding: 8px 10px;
  background: #060c18; border: 1px solid var(--border);
  border-radius: 6px; color: var(--accent);
  font-family: var(--font-mono); font-size: 1.1rem;
  text-align: center; outline: none;
}
.shot-input:focus { border-color: var(--accent); box-shadow: 0 0 10px rgba(0,212,255,0.2); }
.btn-fire {
  padding: 8px 24px;
  background: var(--red); border: none;
  border-radius: 6px; color: white;
  font-family: var(--font-mono); font-size: 0.9rem;
  letter-spacing: 2px; cursor: pointer;
  transition: box-shadow 0.2s, transform 0.1s;
  align-self: flex-end;
}
.btn-fire:hover { box-shadow: 0 0 20px rgba(255,51,68,0.5); transform: translateY(-1px); }
.btn-fire:disabled { opacity: 0.3; cursor: not-allowed; transform: none; box-shadow: none; }

/* ── STATUS BAR ── */
.status-bar {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 10px 16px;
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; flex-wrap: wrap;
}
.status-msg {
  font-family: var(--font-mono);
  font-size: 0.88rem; color: var(--green);
  flex: 1;
}
.status-ships { display: flex; gap: 8px; flex-wrap: wrap; }
.ship-badge {
  font-family: var(--font-mono);
  font-size: 0.68rem; padding: 2px 8px;
  border-radius: 3px; border: 1px solid;
}
.ship-badge.alive { border-color: var(--green); color: var(--green); }
.ship-badge.sunk  { border-color: var(--muted); color: var(--muted); text-decoration: line-through; }

/* ── WIN OVERLAY ── */
#winOverlay {
  position: fixed; inset: 0; z-index: 2000;
  background: rgba(6,12,24,0.95);
  display: none; align-items: center; justify-content: center;
}
#winOverlay.show { display: flex; }
.win-card {
  text-align: center;
  animation: popIn 0.6s cubic-bezier(.34,1.56,.64,1);
}
@keyframes popIn { from{transform:scale(0.5);opacity:0} to{transform:scale(1);opacity:1} }
.win-trophy { font-size: 5rem; margin-bottom: 12px; }
.win-title { font-family: var(--font-mono); font-size: 2.5rem; color: var(--yellow); letter-spacing: 4px; margin-bottom: 8px; }
.win-sub   { font-size: 1rem; color: var(--muted); margin-bottom: 24px; }

/* ── WAITING ── */
.waiting { text-align: center; padding: 40px; }
.waiting-icon { font-size: 3rem; animation: pulse 1.5s infinite; margin-bottom: 12px; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
.waiting p { font-family: var(--font-mono); color: var(--muted); font-size: 0.9rem; }

/* ── SINKING ANIMATION ── */
@keyframes sinkAnim {
  0%   { transform: translateY(0) rotate(0deg); opacity: 1; }
  60%  { transform: translateY(8px) rotate(-8deg); opacity: 0.7; }
  100% { transform: translateY(18px) rotate(-15deg); opacity: 0.4; }
}
.sinking { animation: sinkAnim 1.5s ease-in forwards; }

@keyframes ripple {
  0%   { r: 4; opacity: 0.9; }
  100% { r: 22; opacity: 0; }
}
</style>
</head>
<body>

<!-- WIN OVERLAY -->
<div id="winOverlay">
  <div class="win-card">
    <div class="win-trophy">🏆</div>
    <div class="win-title" id="winTitle">SEIER!</div>
    <div class="win-sub"  id="winSub">Du senket alle motstanderens skip!</div>
    <button class="btn-primary" style="width:200px;margin:0 auto" onclick="location.reload()">🔄 Spill igjen</button>
    <a href="/ligningsvekt/" class="btn-secondary" style="display:block;margin-top:8px;text-align:center;text-decoration:none;padding:10px;border:1px solid var(--muted);border-radius:6px;color:var(--muted);font-family:var(--font-mono);font-size:0.85rem">← Tilbake til meny</a>
  </div>
</div>

<!-- HEADER -->
<div class="header">
  <div class="header-title">⚓ KOORDINATSLAG</div>
  <div class="header-right">
    <div class="header-status" id="headerStatus">VENTER</div>
    <a class="btn-menu" href="/ligningsvekt/">← MENY</a>
  </div>
</div>

<!-- LOBBY SCREEN -->
<div class="overlay" id="lobbyScreen">
  <div class="screen-card">
    <h1>⚓ KOORDINATSLAG</h1>
    <p>Senk motstanderens flåte ved å skyte på koordinater!</p>
    <div class="field-group">
      <div class="field-label">Ditt navn</div>
      <input class="field-input" id="playerNameInput" placeholder="KAPTEIN..." maxlength="16">
    </div>
    <button class="btn-primary" onclick="createRoom()">🚀 OPPRETT ROM</button>
    <div style="margin: 16px 0; color: var(--muted); font-size: 0.8rem; font-family: var(--font-mono)">— ELLER —</div>
    <div class="field-group">
      <div class="field-label">Romkode</div>
      <input class="field-input" id="roomCodeInput" placeholder="ROMKODE" maxlength="6">
    </div>
    <button class="btn-primary" onclick="joinRoom()">⚓ KOBLE TIL ROM</button>
    <div id="lobbyError" style="color:var(--red);font-size:0.8rem;margin-top:10px;font-family:var(--font-mono)"></div>
  </div>
</div>

<!-- WAITING FOR OPPONENT -->
<div class="overlay" id="waitingScreen" style="display:none">
  <div class="screen-card">
    <div class="waiting">
      <div class="waiting-icon">📡</div>
      <h1 style="margin-bottom:8px">ROM: <span id="displayRoomCode" style="color:var(--yellow)"></span></h1>
      <p style="margin-bottom:20px">Del romkoden med motstanderen din</p>
      <p id="waitingMsg">Venter på motstander...</p>
    </div>
  </div>
</div>

<!-- PLACEMENT SCREEN -->
<div id="placementScreen" style="display:none">
  <div class="placement-screen">
    <div class="placement-left">
      <div class="section-title">🗺️ Ditt koordinatsystem — plasser flåten din</div>
      <svg class="grid-svg" id="myPlacementGrid" viewBox="-20 -20 440 440"></svg>
    </div>
    <div class="placement-right">
      <div class="section-title">⚓ Skip</div>
      <div class="ship-list" id="shipList"></div>
      <button class="btn-primary" id="readyBtn" onclick="confirmPlacement()" disabled>✅ KLAR TIL KAMP!</button>
      <div id="placementMsg" style="color:var(--muted);font-size:0.78rem;font-family:var(--font-mono);margin-top:10px;text-align:center"></div>
    </div>
  </div>
</div>

<!-- GAME SCREEN -->
<div id="gameScreen" style="display:none">
  <div class="game-screen">
    <div class="boards-row">
      <div class="board-wrap">
        <div class="board-label">🛡️ MITT BRETT — <span id="myNameLabel">–</span></div>
        <svg class="grid-svg" id="myGrid" viewBox="-20 -20 440 440"></svg>
